# Copy this file to .env and fill in the key locally. Never commit .env.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
# Optional: none, minimal, low, medium, high, xhigh, or max (model-dependent).
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT=60
OPENAI_EVIDENCE_TIMEOUT=180
AGENT_MAX_TURNS=2
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_EVIDENCE_CALLS=4
AGENT_MAX_OUTPUT_TOKENS=8192
OPENAI_IMAGE_DETAIL=high
OPENAI_VISION_ENABLED=true
# Optional pricing used only for usage_report.md cost estimates.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
